<UserControl x:Class="DLI.Connect.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DLI.Connect.Utilities">
    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utilities:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="Root" Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Arkadaşlar" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <!-- Empty state -->
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE716;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Henüz arkadaşın yok." Style="{StaticResource EmptyStateTextStyle}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Sol menüden 'Arkadaş Ekle' bölümüne gidip kullanıcı adı arayarak arkadaşlık isteği gönderebilirsin."
                           Style="{StaticResource EmptyStateTextStyle}" Margin="0,6,0,0" MaxWidth="380" />
            </StackPanel>

            <!-- Friend list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FriendCardStyle}" Margin="0,0,0,10" Padding="16,12">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem>
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Arkadaşı Kaldır" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                            <MenuItem.Command>
                                                <Binding Path="DataContext.RemoveFriendCommand" ElementName="Root" />
                                            </MenuItem.Command>
                                            <MenuItem.CommandParameter>
                                                <Binding />
                                            </MenuItem.CommandParameter>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="{DynamicResource PrimaryGradientBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Username}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#6B7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Çevrimdışı" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Text" Value="Çevrimiçi" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="Sağ tıkla" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Remove confirmation overlay -->
        <Grid Grid.RowSpan="2" Background="#B3000000"
              Visibility="{Binding IsRemoveDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="380" Style="{StaticResource CardStyle}" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Arkadaşı Kaldır" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PendingRemoveDisplayText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Vazgeç" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0"
                                Command="{Binding CancelRemoveCommand}" />
                        <Button Content="Arkadaşı Kaldır" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ConfirmRemoveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

