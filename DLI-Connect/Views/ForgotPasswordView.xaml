<UserControl x:Class="DLI.Connect.Views.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="AuthBackgroundGradientBrush" />
        </Grid.Background>

        <!-- Decorative glow -->
        <Ellipse Width="560" Height="560" Opacity="0.08"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-280,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5865F2" Offset="0" />
                    <GradientStop Color="#5865F2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                    Style="{StaticResource CardStyle}" Padding="32,28">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                            Background="{DynamicResource NavActiveBrush}" BorderBrush="{DynamicResource BubbleSelfBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Şifreni mi unuttun?" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />

                    <TextBlock Text="E-posta adresine şifre sıfırlama bağlantısı göndereceğiz."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" Margin="0,6,0,24" />

                    <TextBlock Text="E-POSTA" Style="{StaticResource LabelTextStyle}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource SearchBrush}"
                            BorderBrush="{DynamicResource DividerStrongBrush}" BorderThickness="1"
                            CornerRadius="12" Height="44">
                        <Grid>
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBox Margin="38,0,12,0" Background="Transparent"
                                     BorderThickness="0" Padding="0" FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="E-posta adresin" FontSize="13" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="38,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Email}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="{DynamicResource SuccessBrush}" Opacity="0.12" CornerRadius="12"
                            Margin="0,14,0,0" Padding="14,10" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmailSent}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="Sıfırlama bağlantısı gönderildi. Gelen kutunu kontrol et."
                                   Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <Button Height="46" Margin="0,20,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SendCommand}" IsEnabled="{Binding IsIdle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Bağlantıyı Gönder" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Gönderiliyor..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <Button Content="Giriş sayfasına dön" Margin="0,18,0,0"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding GoBackCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>

