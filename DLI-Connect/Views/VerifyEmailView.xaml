<UserControl x:Class="DLI.Connect.Views.VerifyEmailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="AuthBackgroundGradientBrush" />
        </Grid.Background>

        <!-- Decorative glow -->
        <Ellipse Width="560" Height="560" Opacity="0.08"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-280,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5865F2" Offset="0" />
                    <GradientStop Color="#5865F2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                    Style="{StaticResource CardStyle}" Padding="32,28">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                            Background="{DynamicResource NavActiveBrush}" BorderBrush="{DynamicResource BubbleSelfBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="E-postanı doğrula" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0" />

                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="Doğrulama bağlantısını " />
                        <Run Text="{Binding Email, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}" />
                        <Run Text=" adresine gönderdik. Bağlantıya tıkladıktan sonra bu sayfa otomatik olarak güncellenir." />
                    </TextBlock>

                    <Border Background="{DynamicResource NavActiveBrush}" CornerRadius="12"
                            Margin="0,16,0,0" Padding="14,10">
                        <TextBlock Text="E-postanı göremiyor musun? Spam klasörünü kontrol et."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    </Border>

                    <TextBlock Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Doğruladıysan e-postayı yeniden gönderip kontrol et."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center"
                               Margin="0,8,0,0" />

                    <Button Height="46" Margin="0,18,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckNowCommand}" IsEnabled="{Binding IsIdle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Kontrol Et" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Kontrol ediliyor..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <Button Height="42" Margin="0,10,0,0" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResendCommand}" IsEnabled="{Binding IsIdle}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Doğrulama E-postasını Yeniden Gönder" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Gönderiliyor..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <Button Content="Farklı bir hesapla giriş yap" Margin="0,14,0,0"
                            Style="{StaticResource LinkButtonStyle}"
                            Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>

