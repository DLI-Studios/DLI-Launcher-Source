<UserControl x:Class="DLI.Connect.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DLI.Connect.Utilities">
    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utilities:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="ConversationItemStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ConversationTemplate">
            <Button Margin="0,0,0,4"
                    Command="{Binding DataContext.OpenConversationCommand, ElementName=Root}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ConversationItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ItemActiveBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem>
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Sohbeti Aç" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem.Command>
                                <Binding Path="DataContext.OpenConversationCommand" ElementName="Root" />
                            </MenuItem.Command>
                            <MenuItem.CommandParameter>
                                <Binding />
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem>
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Kullanıcı Adını Kopyala" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem.Command>
                                <Binding Path="DataContext.CopyUsernameCommand" ElementName="Root" />
                            </MenuItem.Command>
                            <MenuItem.CommandParameter>
                                <Binding />
                            </MenuItem.CommandParameter>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource LogoGradientBrush}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="10" Height="10" CornerRadius="5"
                                BorderBrush="{DynamicResource SidebarBrush}" BorderThickness="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding LastMessageTimeText}" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LastMessageText}" FontSize="11" MaxWidth="150"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" MinWidth="18" Height="18" CornerRadius="9" Margin="6,0,0,0"
                                    Background="{DynamicResource DangerBrush}"
                                    Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UnreadText}" Foreground="White" FontSize="9" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="MessageTemplate">
            <StackPanel>
                <!-- Day separator -->
                <Grid Margin="24,14,24,4"
                      Visibility="{Binding ShowDaySeparator, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="10" Padding="12,4"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DaySeparatorText}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <Grid Margin="0,3,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource LogoGradientBrush}" VerticalAlignment="Top" Margin="0,2,0,0"
                            Visibility="{Binding ShowAvatar, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding SenderName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,3"
                                   Visibility="{Binding ShowAvatar, Converter={StaticResource BoolToVis}}" />

                        <Border Grid.Row="1" MaxWidth="520" Padding="13,9"
                                Background="{DynamicResource BubbleSelfBrush}"
                                BorderBrush="{DynamicResource BubbleSelfBorderBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="16,16,4,16" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOwn}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource BubbleOtherBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BubbleOtherBorderBrush}" />
                                            <Setter Property="CornerRadius" Value="16,16,16,4" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Mesajı Sil" Tag="{Binding}" Click="OnDeleteMessageClick"
                                              Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="Tekrar Gönder" Tag="{Binding}" Click="OnRetryMessageClick"
                                              Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayText}" FontSize="13.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Bottom"
                                           Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}"
                                           ToolTip="Gönderiliyor..." />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="4,3,0,0"
                              Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwn}" Value="False">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Gönderilemedi" FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                           Margin="0,0,5,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Tekrar Dene" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                                           Margin="0,0,7,0" VerticalAlignment="Center"
                                           Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                           Tag="{Binding}" MouseLeftButtonUp="OnRetryTap" />
                                <TextBlock Text="{Binding TimeText}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReadIndicator}" FontSize="9" Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversation list -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,14,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="KONUŞMALAR" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                            Command="{Binding OpenNewChatCommand}" ToolTip="Yeni Sohbet">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="12,12,12,12" Height="34"
                        Background="{DynamicResource SearchBrush}"
                        BorderBrush="{DynamicResource DividerStrongBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Margin="30,0,10,0" FontSize="12"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Sohbet ara" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="8,0,8,8">
                    <StackPanel Visibility="{Binding Conversations.Count, Converter={StaticResource InvBoolToVis}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8BD;" Style="{StaticResource EmptyStateIconStyle}" FontSize="30" />
                        <TextBlock Text="Henüz sohbetin yok." Style="{StaticResource EmptyStateTextStyle}"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="'Yeni Sohbet' ile bir arkadaşınla mesajlaşmaya başla."
                                   Style="{StaticResource EmptyStateTextStyle}" Margin="0,4,0,0" MaxWidth="220" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Conversations.Count, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Conversations}" ItemTemplate="{StaticResource ConversationTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Chat pane -->
        <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- No selection -->
            <StackPanel Grid.RowSpan="3" Visibility="{Binding HasOpened, Converter={StaticResource InvBoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8BD;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Bir sohbet seç" Style="{StaticResource EmptyStateTextStyle}"
                           FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Soldan bir sohbet seç ya da 'Yeni Sohbet' ile arkadaşlarınla mesajlaşmaya başla."
                           Style="{StaticResource EmptyStateTextStyle}" Margin="0,6,0,0" MaxWidth="360" />
            </StackPanel>

            <!-- Chat header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DividerStrongBrush}" BorderThickness="0,0,0,1"
                    Padding="16,10" Visibility="{Binding HasOpened, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource LogoGradientBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selected.Initial}" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selected.DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Çevrimdışı" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.IsOnline}" Value="True">
                                            <Setter Property="Text" Value="Çevrimiçi" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPeerTyping}" Value="True">
                                            <Setter Property="Text" Value="yazıyor..." />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" MaxWidth="300" TextAlignment="Right" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Yakında">
                            <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Yakında">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Yakında">
                            <TextBlock Text="&#xE840;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Yakında">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages -->
            <Grid Grid.Row="1" Visibility="{Binding HasOpened, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding Messages.Count, Converter={StaticResource InvBoolToVis}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Henüz mesaj yok." Style="{StaticResource EmptyStateTextStyle}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="İlk mesajı sen yaz." Style="{StaticResource EmptyStateTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Messages.Count, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,14,0,8">
                        <Button HorizontalAlignment="Center" Margin="0,4,0,12" Padding="14,7" Cursor="Hand"
                                Click="OnLoadOlderClick"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource DividerStrongBrush}"
                                                        BorderThickness="1" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Daha eski mesajları göster" FontSize="11.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Button>

                        <StackPanel Margin="24,6,24,16">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{DynamicResource LogoGradientBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Selected.Initial}" Foreground="White" FontSize="24"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Selected.DisplayName}" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Selected.Username}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="Bu, sohbetin başlangıcı. Seninle buradan konuşacağız."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />

                        <!-- Typing indicator -->
                        <Grid Margin="16,6,16,10"
                              Visibility="{Binding IsPeerTyping, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource LogoGradientBrush}">
                                <TextBlock Text="{Binding Selected.Initial}" Foreground="White" FontSize="12"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Width="64" Padding="13,10" HorizontalAlignment="Left"
                                    Background="{DynamicResource BubbleOtherBrush}"
                                    BorderBrush="{DynamicResource BubbleOtherBorderBrush}" BorderThickness="1"
                                    CornerRadius="16,16,16,4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" />
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Input -->
            <Grid Grid.Row="2" Margin="16,0,16,20"
                  Visibility="{Binding HasOpened, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
                        BorderBrush="{DynamicResource DividerStrongBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                                VerticalAlignment="Bottom" ToolTip="Yakında">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>

                        <Grid Grid.Column="1" Margin="4,0,0,0">
                            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="110"
                                     MinHeight="46" VerticalContentAlignment="Center" Padding="10,8"
                                     Background="Transparent" BorderThickness="0"
                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="Input_KeyDown" />
                            <TextBlock Text="Mesaj yaz..." FontSize="13.5" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MessageText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Margin="0,0,2,0"
                                VerticalAlignment="Bottom" ToolTip="Yakında">
                            <TextBlock Text="&#xE90E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>

                        <Button Grid.Column="3" Width="28" Height="28" Margin="4,6,8,6" VerticalAlignment="Bottom"
                                IsEnabled="{Binding IsIdle}" Command="{Binding SendMessageCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- New chat dialog -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}"
              Visibility="{Binding IsNewChatDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="420" MaxHeight="480" Style="{StaticResource CardStyle}" Padding="24,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Yeni Sohbet" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                Command="{Binding CloseNewChatCommand}">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Mesaj atmak istediğin arkadaşını seç."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,14" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding NewChatFriends}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ConversationItemStyle}"
                                                Command="{Binding DataContext.StartChatCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{DynamicResource LogoGradientBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Username}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="&#xE724;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Arkadaş listende kimse yok. Önce arkadaş eklemen gerekiyor."
                                       Style="{StaticResource EmptyStateTextStyle}" FontSize="12"
                                       Visibility="{Binding NewChatFriends.Count, Converter={StaticResource InvBoolToVis}}"
                                       Margin="0,16,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

