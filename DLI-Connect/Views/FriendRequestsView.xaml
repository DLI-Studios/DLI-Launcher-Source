<UserControl x:Class="DLI.Connect.Views.FriendRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DLI.Connect.Utilities">
    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utilities:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <utilities:InverseBooleanConverter x:Key="InvBool" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Arkadaş İstekleri" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <!-- Empty state -->
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE715;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Bekleyen arkadaşlık isteği yok." Style="{StaticResource EmptyStateTextStyle}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Biri sana istek gönderdiğinde burada görünecek."
                           Style="{StaticResource EmptyStateTextStyle}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Request list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FriendCardStyle}" Margin="0,0,0,10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="{DynamicResource PrimaryGradientBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Ellipse Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#6B7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Reddet" Margin="0,0,10,0"
                                                Command="{Binding DeclineCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Kabul Et" Style="{StaticResource SmallPrimaryButtonStyle}"
                                                Command="{Binding AcceptCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

