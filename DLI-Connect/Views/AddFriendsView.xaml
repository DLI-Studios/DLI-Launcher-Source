<UserControl x:Class="DLI.Connect.Views.AddFriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DLI.Connect.Utilities">
    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utilities:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Arkadaş Ekle" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="Kullanıcı adına göre ara ve arkadaşlık isteği gönder."
                       Style="{StaticResource SubheadingTextStyle}" Margin="0,4,0,0" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="44"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Kullanıcı adı ara" />
                <Button Grid.Column="1" Content="Ara" Style="{StaticResource SmallPrimaryButtonStyle}"
                        Height="44" Margin="10,0,0,0"
                        Command="{Binding SearchCommand}" IsEnabled="{Binding IsIdle}" />
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <!-- Empty state -->
            <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource InvBoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE71D;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Bir kullanıcı adı arayarak başla" Style="{StaticResource EmptyStateTextStyle}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Örnek: arkadaşının kullanıcı adının bir kısmını yaz."
                           Style="{StaticResource EmptyStateTextStyle}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Results -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasSearched, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FriendCardStyle}" Margin="0,0,0,10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="{DynamicResource PrimaryGradientBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Ellipse Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#6B7280" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                            Command="{Binding AddFriendCommand}"
                                            IsEnabled="{Binding CanAdd}">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding StateText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                                <Setter Property="Text" Value="Gönderiliyor..." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

