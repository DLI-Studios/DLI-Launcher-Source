<UserControl x:Class="DLI.Connect.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:DLI.Connect.Utilities"
             xmlns:viewmodels="clr-namespace:DLI.Connect.ViewModels"
             xmlns:views="clr-namespace:DLI.Connect.Views">
    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utilities:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <utilities:EnumEqualsConverter x:Key="EnumEq" />
        <DataTemplate DataType="{x:Type viewmodels:FriendsViewModel}">
            <views:FriendsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AddFriendsViewModel}">
            <views:AddFriendsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:FriendRequestsViewModel}">
            <views:FriendRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MessagesViewModel}">
            <views:MessagesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PartyViewModel}">
            <views:PartyView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon rail -->
        <Border Grid.Column="0" Background="{DynamicResource ServerRailBrush}">
            <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                <Border Width="44" Height="44" CornerRadius="14"
                        Background="{DynamicResource LogoGradientBrush}"
                        Effect="{StaticResource PrimaryGlow}">
                    <TextBlock Text="DLI" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Width="32" Height="2" CornerRadius="1" Background="{DynamicResource DividerBrush}"
                        Margin="0,10,0,10" />

                <!-- Ana Sayfa -->
                <Grid Width="72" Height="48">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoOverviewCommand}" ToolTip="Ana Sayfa">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Mesajlar -->
                <Grid Width="72" Height="48">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoMessagesCommand}" ToolTip="Mesajlar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Arkadaşlar -->
                <Grid Width="72" Height="48">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoFriendsCommand}" ToolTip="Arkadaşlar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Arkadaş Ekle -->
                <Grid Width="72" Height="48">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoAddFriendsCommand}" ToolTip="Arkadaş Ekle">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Arkadaş İstekleri -->
                <Grid Width="72" Height="48">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoRequestsCommand}" ToolTip="Arkadaş İstekleri">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <Grid Width="72" Height="48" Margin="0,8,0,0">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoSettingsCommand}" ToolTip="Ayarlar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <Grid Width="72" Height="48" Margin="0,8,0,0">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoProfileCommand}" ToolTip="Profil">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
</Button>
                </Grid>

                <Grid Width="72" Height="48" Margin="0,8,0,0">
                    <Border Width="4" Height="24" CornerRadius="2" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                            Command="{Binding GoPartyCommand}" ToolTip="Parti">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Nav sidebar -->
        <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,18,20,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DLI" FontSize="22" FontWeight="Black"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="CONNECT" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="6,4,0,0" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,0,12,12">

                        <TextBlock Text="ANA MENÜ" Style="{StaticResource NavSectionHeaderStyle}" Margin="12,4,8,8" />

                        <!-- Ana Sayfa -->
                        <Button Command="{Binding GoOverviewCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="ANA SAYFA" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Overview}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Mesajlar -->
                        <Button Command="{Binding GoMessagesCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="MESAJLAR" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Arkadaşlar -->
                        <Button Command="{Binding GoFriendsCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="ARKADAŞLAR" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="ARKADAŞLIK" Style="{StaticResource NavSectionHeaderStyle}" Margin="12,14,8,8" />

                        <!-- Arkadaş Ekle -->
                        <Button Command="{Binding GoAddFriendsCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="ARKADAŞ EKLE" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Arkadaş İstekleri -->
                        <Button Command="{Binding GoRequestsCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="ARKADAŞ İSTEKLERİ" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="HESAP" Style="{StaticResource NavSectionHeaderStyle}" Margin="12,14,8,8" />

                        <!-- Profil -->
                        <Button Command="{Binding GoProfileCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="PROFİL" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Ayarlar -->
                        <Button Command="{Binding GoSettingsCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="AYARLAR" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Parti -->
                        <Button Command="{Binding GoPartyCommand}" Margin="0,0,0,2">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavItemButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="PARTİ" FontSize="11" FontWeight="Bold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- User card -->
                <Border Grid.Row="2" Margin="12,0,12,12" Padding="10,10"
                        Background="{DynamicResource UserCardBrush}"
                        BorderBrush="{DynamicResource UserCardBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{DynamicResource LogoGradientBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="13"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#80848E" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusColorHex}" Value="#23A55A">
                                                    <Setter Property="Fill" Value="#23A55A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusColorHex}" Value="#F0B232">
                                                    <Setter Property="Fill" Value="#F0B232" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusColorHex}" Value="#F23F43">
                                                    <Setter Property="Fill" Value="#F23F43" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="5,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" ToolTip="Profil"
                                    Command="{Binding GoProfileCommand}">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" ToolTip="Ayarlar"
                                    Command="{Binding GoSettingsCommand}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                    Command="{Binding LogoutCommand}" IsEnabled="{Binding IsIdle}" ToolTip="Çıkış Yap">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource DividerStrongBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid Height="48">
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ANA SAYFA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Friends}" Value="True">
                                        <Setter Property="Text" Value="ARKADAŞLAR" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=AddFriends}" Value="True">
                                        <Setter Property="Text" Value="ARKADAŞ EKLE" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Requests}" Value="True">
                                        <Setter Property="Text" Value="ARKADAŞ İSTEKLERİ" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Messages}" Value="True">
                                        <Setter Property="Text" Value="MESAJLAR" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Profile}" Value="True">
                                        <Setter Property="Text" Value="PROFİL" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Settings}" Value="True">
                                        <Setter Property="Text" Value="AYARLAR" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource EnumEq}, ConverterParameter=Party}" Value="True">
                                        <Setter Property="Text" Value="PARTİ" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                <Grid Margin="32,28,32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="HOŞ GELDİN" Style="{StaticResource NavSectionHeaderStyle}" />
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="DLI Connect hesabına giriş yaptın. Sol menüden arkadaşlarını bulabilir, istek gönderip kabul edebilirsin."
                                   Style="{StaticResource SubheadingTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,24,0,0">
                        <TextBlock Text="PROFİL" Style="{StaticResource NavSectionHeaderStyle}" Margin="0,0,0,10" />

                        <Border Style="{StaticResource CardStyle}" Padding="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="56" Height="56" CornerRadius="28"
                                        Background="{DynamicResource LogoGradientBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Username}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,40,0">
                                            <TextBlock Text="DURUM" Style="{StaticResource NavSectionHeaderStyle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}"
                                                         Effect="{StaticResource StatusGlow}" VerticalAlignment="Center" />
                                                <TextBlock Text="Çevrimiçi" FontSize="12" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="E-POSTA" Style="{StaticResource NavSectionHeaderStyle}" />
                                            <TextBlock Text="{Binding Email}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Çıkış Yap" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="18,10" VerticalAlignment="Top"
                                        Command="{Binding LogoutCommand}" IsEnabled="{Binding IsIdle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ContentControl Grid.Row="1" Content="{Binding CurrentSection}"
                            Visibility="{Binding IsOverview, Converter={StaticResource InvBoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>

